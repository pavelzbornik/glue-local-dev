{
	"name": "AWS Glue for local dev",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "."
	},
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.shell.linux": "/bin/bash",
				"python.defaultInterpreterPath": "/usr/bin/python3",
				"python.analysis.extraPaths": [
					"/home/glue_user/aws-glue-libs/PyGlue.zip:/home/glue_user/spark/python/lib/py4j-0.10.9.5-src.zip:/home/glue_user/spark/python/"
				],
				"python.testing.pytestArgs": [
					"tests"
				],
				"python.testing.unittestEnabled": false,
				"python.testing.pytestEnabled": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"[json]": {
				"editor.defaultFormatter": "esbenp.prettier-vscode"
				},
				"editor.formatOnSave": true
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-toolsai.jupyter",
				"ms-toolsai.datawrangler",
				"esbenp.prettier-vscode",
				"ms-python.black-formatter",
        		"ms-python.flake8",
				"ms-python.isort",
				"prettier.prettier-vscode",
				"ms-azuretools.vscode-docker",
				"amazonwebservices.aws-toolkit-vscode",
				"bierner.markdown-mermaid",
				"hashicorp.terraform",
			]
		},
	},
	"postCreateCommand": "pip3 install -r requirements.txt && echo >> ~/.bashrc && echo alias ll=\\'ls -alF\\' >> ~/.bashrc && echo 'Environment setup complete.'",
	"postStartCommand": "nohup bash -c '/home/glue_user/jupyter/jupyter.sh &' > /tmp/postStart.out",
	"remoteUser": "glue_user",
	"containerEnv": {
		"AWS_PROFILE": "default",
		"DISABLE_SSL": "true"
	},
	"forwardPorts": [4040, 18080, 8998, 8889],
	"portsAttributes": {
		"4040": {
			"label": "Spark",
			"protocol": "http"
		},
		"8889": {
			"label": "JupyterLab",
			"protocol": "http"
		},
		"8998": {
			"label": "Livy",
			"protocol": "http"
		},
		"18080": {
			"label": "Spark History Server",
			"protocol": "http"
		}
	},
}
